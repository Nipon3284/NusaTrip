# ==========================================
# NusaTrip Platform - Environment Variables
# Salin file ini menjadi .env.local untuk development
# ==========================================

# ─── 1. SUPABASE (Database Cloud & Real-time) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here (Hanya di server, jangan gunakan NEXT_PUBLIC)

# ─── 2. FIREBASE AUTH & STORAGE (Opsional / Client SSO) ───
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nusatrip-travel.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nusatrip-travel
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nusatrip-travel.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=832726490123
NEXT_PUBLIC_FIREBASE_APP_ID=1:832726490123:web:...

# ─── 3. GOOGLE MAPS PLATFORM (GIS Mitra Mapping & Autocomplete) ───
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# ─── 4. INTERNAL GATEWAY & ADMIN AUTHENTICATION ───
ADMIN_ID=admin
ADMIN_PIN=123456
SESSION_SECRET=nusatrip_internal_auth_token_2026_change_in_production
