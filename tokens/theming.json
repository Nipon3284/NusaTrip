        "page": { "$value": "{color.primitive.slate.950}", "$type": "color" },
        "card": { "$value": "{color.primitive.slate.900}", "$type": "color" }
      },
      "brand": {
        "primary": { "$value": "{color.primitive.indigo.400}", "$type": "color" }
      }
    }
  }
