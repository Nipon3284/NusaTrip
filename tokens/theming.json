      "surface": {
        "page": { "$value": "{color.semantic.surface.page}", "$type": "color" },
        "card": { "$value": "{color.semantic.surface.card}", "$type": "color" }
      },
      "brand": {
        "primary": { "$value": "{color.semantic.brand.primary}", "$type": "color" }
      }
    },
    "dark": {
